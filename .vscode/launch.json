{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Spatial Audio Critic Studio",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/launch_studio.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Run TurnScope CLI Analyze",
      "type": "python",
      "request": "launch",
      "module": "turnscope.cli",
      "args": ["analyze", "--help"],
      "console": "integratedTerminal"
    },
    {
      "name": "Run Pytest Suite",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal"
    }
  ]
}
